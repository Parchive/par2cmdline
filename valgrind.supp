# Unsynchronising the C++ streams from C stdio gives cin/cout/cerr and their
# wide counterparts their own filebufs, whose buffers belong to static objects
# and are never freed
{
   libstdcxx_sync_with_stdio_buffers
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:_Znam
   ...
   fun:_ZNSt8ios_base15sync_with_stdioEb
}

# The signal thread is detached and still waiting in sigwait when par2 exits,
# so its state and the TLS that pthread_create allocated for it are never freed
{
   par2_signal_thread
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:_ZL13HandleSignalsv
   fun:main
}
